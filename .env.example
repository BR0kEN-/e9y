HOST=0.0.0.0
PORT=8085

# Required by every HTTP route.
BASIC_AUTH_USERNAME=change-me
BASIC_AUTH_PASSWORD=change-me-to-a-long-random-password

# Required!
PUPPETEER_EXECUTABLE_PATH="/ABSOLUTE/PATH/PRINTED/BY/THE/BROWSER/INSTALL/COMMAND"
PUPPETEER_NAVIGATION_TIMEOUT_MS=30000
PUPPETEER_HEADLESS=true

DTEK_COOKIES_JSON='{"dnem": [{"name":"visid_incap_...","value":"..."}]}'
# Logs crawler stages and disables HTTP Basic Auth. Use only on a trusted host.
DEBUG=false
# Forces every request to query its upstream source and disables stale fallback.
BYPASS_CACHE=false
# Fresh-cache lifetime. Requests made during this period never reach the source.
DTEK_CACHE_TTL_SECONDS=180
# Reload the persistent regional page periodically as a schedule-freshness fallback.
DTEK_PAGE_TTL_SECONDS=900
NERC_CACHE_TTL_SECONDS=86400
